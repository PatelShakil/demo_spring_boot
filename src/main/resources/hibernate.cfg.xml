<?xml version="1.0" encoding="utf-8"?>
<hibernate-configuration xmlns="urn:hibernate:configuration"
                         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                         xsi:schemaLocation="urn:hibernate:configuration https://hibernate.org/xsd/orm/cfg/hibernate-configuration-6.0.xsd">

    <session-factory>
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/hibernate_demo</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">shakil</property>

        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Entity class mapping -->
        <mapping class="com.shakil.hibernate_demo.model.Student"/>
    </session-factory>
</hibernate-configuration>